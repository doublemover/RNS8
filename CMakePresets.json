{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cpu-debug",
      "displayName": "CPU + vcpkg (Debug)",
      "description": "CPU-only development preset with HIP and accelerator backends disabled.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cpu-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "RNS8_ENABLE_HIP": "OFF",
        "RNS8_ENABLE_HIPBLASLT": "OFF",
        "RNS8_ENABLE_CK": "OFF",
        "RNS8_ENABLE_ROCWMMA": "OFF",
        "RNS8_ENABLE_AMDGPU_BUILTINS": "OFF"
      }
    },
    {
      "name": "cpu-release",
      "displayName": "CPU + vcpkg (Release)",
      "inherits": "cpu-debug",
      "binaryDir": "${sourceDir}/build/cpu-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "cpu-asan-ubsan-debug",
      "displayName": "CPU + native packages + ASan/UBSan (Debug)",
      "description": "Optional CPU-only non-Windows sanitizer preset for Clang/GCC-like toolchains using native package discovery only.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cpu-asan-ubsan-debug",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined",
        "CMAKE_CXX_FLAGS_DEBUG": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined",
        "CMAKE_EXE_LINKER_FLAGS_DEBUG": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS_DEBUG": "-fsanitize=address,undefined",
        "RNS8_ENABLE_HIP": "OFF",
        "RNS8_ENABLE_HIPBLASLT": "OFF",
        "RNS8_ENABLE_CK": "OFF",
        "RNS8_ENABLE_ROCWMMA": "OFF",
        "RNS8_ENABLE_AMDGPU_BUILTINS": "OFF"
      }
    },
    {
      "name": "windows-clang-asan-debug",
      "displayName": "Windows clang-cl + vcpkg + ASan/libFuzzer (Debug)",
      "description": "CPU-only Windows hardening preset. HIP stays disabled; fuzzers are built with LLVM libFuzzer and AddressSanitizer.",
      "inherits": "cpu-debug",
      "binaryDir": "${sourceDir}/build/windows-clang-asan-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "$env{LLVM_ROOT}/bin/clang-cl.exe",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "/fsanitize=address /Zi /O1 /MT",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "RNS8_BUILD_SHARED": "OFF",
        "RNS8_BUILD_FUZZERS": "ON",
        "RNS8_ENABLE_WINDOWS_CLANG_ASAN": "ON",
        "RNS8_ENABLE_HIP": "OFF",
        "RNS8_ENABLE_HIPBLASLT": "OFF",
        "RNS8_ENABLE_CK": "OFF",
        "RNS8_ENABLE_ROCWMMA": "OFF",
        "RNS8_ENABLE_AMDGPU_BUILTINS": "OFF"
      }
    },
    {
      "name": "windows-msvc-hip-debug",
      "displayName": "Windows MSVC + HIP SDK + vcpkg (Debug)",
      "description": "Windows Radeon bring-up preset using Ninja, vcpkg, and explicit HIP SDK paths.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-msvc-hip-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "RNS8_ENABLE_HIP": "ON",
        "RNS8_HIP_ROOT": "C:/Program Files/AMD/ROCm/7.1",
        "RNS8_AMDGPU_TARGETS": "gfx1100",
        "RNS8_ROCM_DEPS_BUILD_ROOT": "${sourceDir}/out/third_party/rocm/build/windows-gfx1100",
        "RNS8_ROCM_DEPS_INSTALL_ROOT": "${sourceDir}/out/third_party/rocm/install/windows-gfx1100",
        "RNS8_CK_ROOT": "${sourceDir}/third_party/rocm/composable_kernel",
        "RNS8_ROCWMMA_ROOT": "${sourceDir}/third_party/rocm/rocWMMA"
      }
    },
    {
      "name": "windows-msvc-hip-release",
      "displayName": "Windows MSVC + HIP SDK + vcpkg (Release)",
      "inherits": "windows-msvc-hip-debug",
      "binaryDir": "${sourceDir}/build/windows-msvc-hip-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-msvc-hip-accelerator-probe",
      "displayName": "Windows MSVC + HIP SDK accelerator probe (Debug)",
      "description": "Evidence-only accelerator component probe preset; keeps accelerator backend enable flags disabled.",
      "inherits": "windows-msvc-hip-debug",
      "binaryDir": "${sourceDir}/build/windows-msvc-hip-accelerator-probe",
      "cacheVariables": {
        "RNS8_PROBE_ACCELERATORS": "ON",
        "RNS8_ENABLE_HIPBLASLT": "OFF",
        "RNS8_ENABLE_CK": "OFF",
        "RNS8_ENABLE_ROCWMMA": "OFF",
        "RNS8_ENABLE_AMDGPU_BUILTINS": "OFF"
      }
    },
    {
      "name": "windows-msvc-hipblaslt-debug",
      "displayName": "Windows MSVC + HIP SDK + hipBLASLt baseline (Debug)",
      "description": "Windows gfx1100 hipBLASLt baseline backend build with direct HIP residency support.",
      "inherits": "windows-msvc-hip-debug",
      "binaryDir": "${sourceDir}/build/windows-msvc-hipblaslt-debug",
      "cacheVariables": {
        "RNS8_ENABLE_HIPBLASLT": "ON",
        "RNS8_ENABLE_CK": "OFF",
        "RNS8_ENABLE_ROCWMMA": "OFF",
        "RNS8_ENABLE_AMDGPU_BUILTINS": "OFF"
      }
    },
    {
      "name": "windows-msvc-hipblaslt-release",
      "displayName": "Windows MSVC + HIP SDK + hipBLASLt baseline (Release)",
      "description": "Windows gfx1100 hipBLASLt baseline backend release build for reviewed performance captures.",
      "inherits": "windows-msvc-hipblaslt-debug",
      "binaryDir": "${sourceDir}/build/windows-msvc-hipblaslt-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-msvc-ck-debug",
      "displayName": "Windows MSVC + HIP SDK + CK fused accelerator (Debug)",
      "description": "Windows gfx1100 opt-in CK fused accelerator backend build with repo-local Composable Kernel headers.",
      "inherits": "windows-msvc-hip-debug",
      "binaryDir": "${sourceDir}/build/windows-msvc-ck-debug",
      "cacheVariables": {
        "RNS8_ENABLE_HIPBLASLT": "OFF",
        "RNS8_ENABLE_CK": "ON",
        "RNS8_ENABLE_ROCWMMA": "OFF",
        "RNS8_ENABLE_AMDGPU_BUILTINS": "OFF"
      }
    },
    {
      "name": "windows-msvc-ck-release",
      "displayName": "Windows MSVC + HIP SDK + CK fused accelerator (Release)",
      "description": "Windows gfx1100 opt-in CK fused accelerator release build for reviewed performance captures.",
      "inherits": "windows-msvc-ck-debug",
      "binaryDir": "${sourceDir}/build/windows-msvc-ck-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-msvc-rocwmma-debug",
      "displayName": "Windows MSVC + HIP SDK + rocWMMA hot kernels (Debug)",
      "description": "Windows gfx1100 opt-in rocWMMA signed-int8 fused accelerator backend build with repo-local rocWMMA headers.",
      "inherits": "windows-msvc-hip-debug",
      "binaryDir": "${sourceDir}/build/windows-msvc-rocwmma-debug",
      "cacheVariables": {
        "RNS8_ENABLE_HIPBLASLT": "OFF",
        "RNS8_ENABLE_CK": "OFF",
        "RNS8_ENABLE_ROCWMMA": "ON",
        "RNS8_ENABLE_AMDGPU_BUILTINS": "OFF"
      }
    },
    {
      "name": "windows-msvc-rocwmma-release",
      "displayName": "Windows MSVC + HIP SDK + rocWMMA hot kernels (Release)",
      "description": "Windows gfx1100 opt-in rocWMMA signed-int8 fused accelerator release build for reviewed performance captures.",
      "inherits": "windows-msvc-rocwmma-debug",
      "binaryDir": "${sourceDir}/build/windows-msvc-rocwmma-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-rocm-debug",
      "displayName": "Linux ROCm + native packages (Debug)",
      "description": "Linux ROCm production/profiling validation preset using system packages and native CMake discovery only. Represented only until run on a real Linux ROCm host with supported hardware.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-rocm-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RNS8_ENABLE_HIP": "ON",
        "RNS8_ENABLE_HIPBLASLT": "OFF",
        "RNS8_ENABLE_CK": "OFF",
        "RNS8_ENABLE_ROCWMMA": "OFF",
        "RNS8_ENABLE_AMDGPU_BUILTINS": "OFF",
        "RNS8_HIP_ROOT": "/opt/rocm",
        "RNS8_AMDGPU_TARGETS": "gfx942;gfx950",
        "RNS8_ROCM_DEPS_BUILD_ROOT": "",
        "RNS8_ROCM_DEPS_INSTALL_ROOT": "",
        "RNS8_ROCM_COVERAGE_TARGETS": "gfx1030;gfx1100;gfx1200;gfx1201;gfx90a;gfx942;gfx950"
      }
    },
    {
      "name": "linux-rocm-release",
      "displayName": "Linux ROCm + native packages (Release)",
      "inherits": "linux-rocm-debug",
      "binaryDir": "${sourceDir}/build/linux-rocm-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-cdna-debug",
      "displayName": "Linux ROCm CDNA + native packages (Debug)",
      "description": "Clean Linux CDNA real-host preset using /opt/rocm and native package discovery only; no vcpkg toolchain, Windows triplet, or repo-local generated accelerator dependency roots.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-cdna-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RNS8_ENABLE_HIP": "ON",
        "RNS8_ENABLE_HIPBLASLT": "OFF",
        "RNS8_ENABLE_CK": "OFF",
        "RNS8_ENABLE_ROCWMMA": "OFF",
        "RNS8_ENABLE_AMDGPU_BUILTINS": "OFF",
        "RNS8_HIP_ROOT": "/opt/rocm",
        "RNS8_AMDGPU_TARGETS": "gfx90a;gfx942;gfx950",
        "RNS8_ROCM_COVERAGE_TARGETS": "gfx90a;gfx942;gfx950",
        "RNS8_ROCM_DEPS_BUILD_ROOT": "",
        "RNS8_ROCM_DEPS_INSTALL_ROOT": "",
        "RNS8_CK_ROOT": "",
        "RNS8_ROCWMMA_ROOT": ""
      }
    },
    {
      "name": "linux-cdna-release",
      "displayName": "Linux ROCm CDNA + native packages (Release)",
      "inherits": "linux-cdna-debug",
      "binaryDir": "${sourceDir}/build/linux-cdna-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-cdna-accelerators-release",
      "displayName": "Linux ROCm CDNA accelerators + native packages (Release)",
      "description": "Clean real-host CDNA preset for MI300X/Instinct accelerator probing with native ROCm package discovery only; no vcpkg toolchain, Windows paths, or repo-local generated dependency roots.",
      "inherits": "linux-cdna-release",
      "binaryDir": "${sourceDir}/build/linux-cdna-accelerators-release",
      "cacheVariables": {
        "RNS8_PROBE_ACCELERATORS": "ON",
        "RNS8_ENABLE_HIPBLASLT": "ON",
        "RNS8_ENABLE_CK": "ON",
        "RNS8_ENABLE_ROCWMMA": "ON",
        "RNS8_ENABLE_ROCWMMA_WRAP64_CANDIDATE_TESTS": "OFF",
        "RNS8_ENABLE_AMDGPU_BUILTINS": "OFF",
        "RNS8_HIP_ROOT": "/opt/rocm",
        "RNS8_AMDGPU_TARGETS": "gfx90a;gfx942;gfx950",
        "RNS8_ROCM_COVERAGE_TARGETS": "gfx90a;gfx942;gfx950",
        "RNS8_ROCM_DEPS_BUILD_ROOT": "",
        "RNS8_ROCM_DEPS_INSTALL_ROOT": "",
        "RNS8_CK_ROOT": "",
        "RNS8_ROCWMMA_ROOT": ""
      }
    },
    {
      "name": "linux-rocm-accelerator-probe",
      "displayName": "Linux ROCm accelerator probe (Debug)",
      "description": "Evidence-only Linux accelerator component probe preset; keeps accelerator backend enable flags disabled.",
      "inherits": "linux-rocm-debug",
      "binaryDir": "${sourceDir}/build/linux-rocm-accelerator-probe",
      "cacheVariables": {
        "RNS8_PROBE_ACCELERATORS": "ON",
        "RNS8_ENABLE_HIPBLASLT": "OFF",
        "RNS8_ENABLE_CK": "OFF",
        "RNS8_ENABLE_ROCWMMA": "OFF",
        "RNS8_ENABLE_AMDGPU_BUILTINS": "OFF"
      }
    },
    {
      "name": "linux-cpu-debug",
      "displayName": "Linux CPU + native packages (Debug)",
      "description": "Linux CPU-only development preset using system packages and native CMake discovery only.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-cpu-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RNS8_ENABLE_HIP": "OFF",
        "RNS8_ENABLE_HIPBLASLT": "OFF",
        "RNS8_ENABLE_CK": "OFF",
        "RNS8_ENABLE_ROCWMMA": "OFF",
        "RNS8_ENABLE_AMDGPU_BUILTINS": "OFF"
      }
    },
    {
      "name": "linux-cpu-release",
      "displayName": "Linux CPU + native packages (Release)",
      "inherits": "linux-cpu-debug",
      "binaryDir": "${sourceDir}/build/linux-cpu-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
