# Consume the existing selected optional dependencies. Installed consumers pass
# the same explicit include/library components; this file never installs or
# guesses a different dependency root.
option(RNS8_WORKLOAD_ENABLE_GMP "Build the real GMP integer workload comparator" ${RNS8_ENABLE_GMP})
option(RNS8_WORKLOAD_ENABLE_FLINT "Build the real FLINT integer workload comparator" ${RNS8_ENABLE_FLINT})
set(RNS8_WORKLOAD_FLINT_EXTRA_LIBRARIES "" CACHE STRING "Explicit additional static FLINT link inputs, for example the selected MPFR archive")
set(_workload_reference_identity "{}")
foreach(_reference IN ITEMS GMP FLINT)
  if(RNS8_WORKLOAD_ENABLE_${_reference} OR (_reference STREQUAL "GMP" AND RNS8_WORKLOAD_ENABLE_FLINT))
    if(_reference STREQUAL "GMP")
      set(_headers gmp.h)
    else()
      set(_headers flint/flint.h flint/fmpz.h flint/fmpz_mat.h)
    endif()
    if(NOT IS_DIRECTORY "${RNS8_${_reference}_INCLUDE_DIR}" OR NOT EXISTS "${RNS8_${_reference}_LIBRARY}")
      message(FATAL_ERROR "The ${_reference} workload comparator requires selected RNS8_${_reference}_INCLUDE_DIR and RNS8_${_reference}_LIBRARY. Configure the project optional dependency or pass those explicit components to this installed consumer; no package installation occurs here.")
    endif()
    set(_entry "{}")
    set(_header_hashes "{}")
    foreach(_header IN LISTS _headers)
      set(_path "${RNS8_${_reference}_INCLUDE_DIR}/${_header}")
      if(NOT EXISTS "${_path}")
        message(FATAL_ERROR "Missing selected ${_reference} workload header: ${_path}")
      endif()
      file(SHA256 "${_path}" _hash)
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_path}")
      string(JSON _header_hashes SET "${_header_hashes}" "${_header}" "\"${_hash}\"")
    endforeach()
    file(SHA256 "${RNS8_${_reference}_LIBRARY}" _hash)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${RNS8_${_reference}_LIBRARY}")
    string(JSON _entry SET "${_entry}" headers_sha256 "${_header_hashes}")
    string(JSON _entry SET "${_entry}" link_input_sha256 "\"${_hash}\"")
    string(JSON _entry SET "${_entry}" runtime_binary_sha256 null)
    string(JSON _entry SET "${_entry}" runtime_binary_verified false)
    set(_extra_hashes "[]")
    if(_reference STREQUAL "FLINT")
      foreach(_extra IN LISTS RNS8_WORKLOAD_FLINT_EXTRA_LIBRARIES)
        if(NOT EXISTS "${_extra}" OR IS_DIRECTORY "${_extra}")
          message(FATAL_ERROR "Missing explicit FLINT workload link dependency: ${_extra}")
        endif()
        file(SHA256 "${_extra}" _extra_hash)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_extra}")
        string(JSON _length LENGTH "${_extra_hashes}")
        string(JSON _extra_hashes SET "${_extra_hashes}" ${_length} "\"${_extra_hash}\"")
      endforeach()
    endif()
    string(JSON _entry SET "${_entry}" extra_link_inputs_sha256 "${_extra_hashes}")
    string(JSON _workload_reference_identity SET "${_workload_reference_identity}" "${_reference}" "${_entry}")
    if(NOT TARGET RNS8::${_reference})
      add_library(RNS8::${_reference} UNKNOWN IMPORTED)
      set_target_properties(RNS8::${_reference} PROPERTIES IMPORTED_LOCATION "${RNS8_${_reference}_LIBRARY}"
        INTERFACE_INCLUDE_DIRECTORIES "${RNS8_${_reference}_INCLUDE_DIR}")
    endif()
  endif()
endforeach()

function(rns8_bind_workload_optional_references target)
  if(RNS8_WORKLOAD_ENABLE_GMP)
    target_compile_definitions(${target} PRIVATE RNS8_WORKLOAD_HAVE_GMP=1)
    target_link_libraries(${target} PRIVATE RNS8::GMP)
  endif()
  if(RNS8_WORKLOAD_ENABLE_FLINT)
    target_compile_definitions(${target} PRIVATE RNS8_WORKLOAD_HAVE_FLINT=1)
    target_link_libraries(${target} PRIVATE RNS8::FLINT ${RNS8_WORKLOAD_FLINT_EXTRA_LIBRARIES} RNS8::GMP)
  endif()
endfunction()
