<?xml version="1.0" encoding="utf-8"?>
<!-- Separate heap role. IFEO changes belong to the authorized settings lease. -->
<WindowsPerformanceRecorder Version="1.0" Author="RNS8">
  <Profiles>
    <SystemCollector Id="Rns8HeapSystemCollector" Name="NT Kernel Logger">
      <BufferSize Value="128" />
      <Buffers Value="64" />
      <MaximumFileSize Value="128" FileMode="Sequential" />
    </SystemCollector>
    <EventCollector Id="Rns8HeapMarkerCollector" Name="RNS8 heap operation markers">
      <BufferSize Value="64" />
      <Buffers Value="16" />
      <MaximumFileSize Value="16" FileMode="Sequential" />
    </EventCollector>
    <HeapEventCollector Id="Rns8HeapCollector" Name="RNS8 native host heap">
      <BufferSize Value="64" />
      <Buffers Value="64" />
      <MaximumFileSize Value="96" FileMode="Sequential" />
    </HeapEventCollector>
    <SystemProvider Id="Rns8HeapSystemProvider">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="SampledProfile" />
      </Keywords>
      <Stacks>
        <Stack Value="SampledProfile" />
        <Stack Value="HeapAllocation" />
        <Stack Value="HeapReallocation" />
        <Stack Value="HeapFree" />
        <Stack Value="HeapCreate" />
        <Stack Value="HeapDestroy" />
      </Stacks>
    </SystemProvider>
    <EventProvider Id="Rns8HeapMarkerProvider" Name="ac42f789-71b2-4a0b-a45c-5c66f41ab813" Level="4">
      <Keywords>
        <Keyword Value="0x1" />
      </Keywords>
    </EventProvider>
    <HeapEventProvider Id="Rns8HeapProvider" />
    <Profile Id="Rns8Heap.Verbose.File" Name="Rns8Heap" Description="Bounded native heap events and operation identities" LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="Rns8HeapSystemCollector">
          <SystemProviderId Value="Rns8HeapSystemProvider" />
        </SystemCollectorId>
        <EventCollectorId Value="Rns8HeapMarkerCollector">
          <EventProviders>
            <EventProviderId Value="Rns8HeapMarkerProvider" />
          </EventProviders>
        </EventCollectorId>
        <HeapEventCollectorId Value="Rns8HeapCollector">
          <HeapEventProviders>
            <HeapEventProviderId Value="Rns8HeapProvider" />
          </HeapEventProviders>
        </HeapEventCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
