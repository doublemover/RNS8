<?xml version="1.0" encoding="utf-8"?>
<!-- Opt-in system scheduler window. Sequential cap never overwrites early data. -->
<WindowsPerformanceRecorder Version="1.0" Author="RNS8">
  <Profiles>
    <SystemCollector Id="Rns8CpuScheduleCollector" Name="NT Kernel Logger">
      <BufferSize Value="128" />
      <Buffers Value="64" />
      <MaximumFileSize Value="128" FileMode="Sequential" />
    </SystemCollector>
    <EventCollector Id="Rns8ScheduleMarkerCollector" Name="RNS8 scheduling host markers">
      <BufferSize Value="64" />
      <Buffers Value="16" />
      <MaximumFileSize Value="16" FileMode="Sequential" />
    </EventCollector>
    <SystemProvider Id="Rns8CpuScheduleProvider">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="SampledProfile" />
        <Keyword Value="CSwitch" />
        <Keyword Value="ReadyThread" />
      </Keywords>
      <Stacks>
        <Stack Value="SampledProfile" />
        <Stack Value="CSwitch" />
        <Stack Value="ReadyThread" />
      </Stacks>
    </SystemProvider>
    <EventProvider Id="Rns8ScheduleMarkerProvider" Name="ac42f789-71b2-4a0b-a45c-5c66f41ab813" Level="4">
      <Keywords>
        <Keyword Value="0x1" />
      </Keywords>
    </EventProvider>
    <Profile Id="Rns8CpuSchedule.Verbose.File" Name="Rns8CpuSchedule" Description="Bounded CPU and opt-in scheduler observations" LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="Rns8CpuScheduleCollector">
          <SystemProviderId Value="Rns8CpuScheduleProvider" />
        </SystemCollectorId>
        <EventCollectorId Value="Rns8ScheduleMarkerCollector">
          <EventProviders>
            <EventProviderId Value="Rns8ScheduleMarkerProvider" />
          </EventProviders>
        </EventCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
