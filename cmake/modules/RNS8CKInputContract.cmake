# CK changed INT8 WMMA's default operand interpretation between source releases.
# Bind the actual selected headers, not a version-number assumption.
function(rns8_ck_wmma_input_contract header out_signed)
  if(NOT EXISTS "${header}")
    message(FATAL_ERROR "CK WMMA operand contract header is missing: ${header}")
  endif()
  file(STRINGS "${header}" _defaults REGEX "bool neg_[ab][ \t]*=[ \t]*(true|false)")
  set(_mode "")
  set(_a 0)
  set(_b 0)
  foreach(_line IN LISTS _defaults)
    if(NOT _line MATCHES "bool neg_([ab])[ \t]*=[ \t]*(true|false)")
      message(FATAL_ERROR "Unsupported CK WMMA operand contract")
    endif()
    set(_operand "${CMAKE_MATCH_1}")
    set(_value "${CMAKE_MATCH_2}")
    if(NOT _mode STREQUAL "" AND NOT _mode STREQUAL _value)
      message(FATAL_ERROR "Mixed CK WMMA operand defaults require an explicit integration review")
    endif()
    set(_mode "${_value}")
    math(EXPR _${_operand} "${_${_operand}}+1")
  endforeach()
  if(_mode STREQUAL "" OR _a EQUAL 0 OR NOT _a EQUAL _b)
    message(FATAL_ERROR "Unknown CK WMMA operand defaults require an explicit integration review")
  endif()
  if(_mode STREQUAL "true")
    set(${out_signed} 1 PARENT_SCOPE)
  else()
    set(${out_signed} 0 PARENT_SCOPE)
  endif()
endfunction()
