include_guard(GLOBAL)

# These optional backends compile one host launch/lowering contract. Direct HIP
# can package a mixed target set, but that does not make it valid for CK/rocWMMA.
function(rns8_matrix_target_contract output backend)
  set(_wave "")
  foreach(_target IN LISTS ARGN)
    if(NOT _target MATCHES "^(gfx[0-9a-f]+)(:(xnack|sramecc)[+-])*$")
      message(FATAL_ERROR "Malformed ${backend} target: ${_target}")
    endif()
    string(REPLACE ":" ";" _tokens "${_target}")
    list(POP_FRONT _tokens _base)
    set(_seen_features)
    foreach(_feature IN LISTS _tokens)
      string(REGEX REPLACE "[+-]$" "" _key "${_feature}")
      if(_key IN_LIST _seen_features)
        message(FATAL_ERROR "Duplicate ${backend} target feature: ${_target}")
      endif()
      list(APPEND _seen_features "${_key}")
    endforeach()
    if(_base MATCHES "^(gfx908|gfx90a|gfx940|gfx941|gfx942|gfx950)$")
      set(_candidate 64)
    elseif(_base MATCHES "^(gfx1100|gfx1101|gfx1102|gfx1200|gfx1201)$")
      set(_candidate 32)
    else()
      message(FATAL_ERROR "${backend} has no admitted lowering for target ${_target}")
    endif()
    if(_wave AND NOT _wave EQUAL _candidate)
      message(FATAL_ERROR
        "${backend} cannot package mixed wave32/wave64 targets (${ARGN}) with one host lowering. Use separate builds or disable this optional backend for a mixed direct-HIP package.")
    endif()
    set(_wave ${_candidate})
  endforeach()
  if(NOT _wave)
    message(FATAL_ERROR "${backend} requires an explicit nonempty target list")
  endif()
  set(${output} ${_wave} PARENT_SCOPE)
endfunction()
