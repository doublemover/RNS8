# Shared by build-tree discovery and installed consumers. Do not embed producer
# machine paths: the consumer supplies its own coherent SDK/package selection.
function(rns8_resolve_hipblaslt_package out_found out_message)
  set(${out_found} FALSE PARENT_SCOPE)
  set(_root "")
  foreach(_key IN ITEMS RNS8_HIPBLASLT_ROOT RNS8_HIP_ROOT)
    if(${_key})
      set(_root "${${_key}}")
      break()
    endif()
  endforeach()
  if(NOT _root AND (NOT hipblaslt_DIR OR hipblaslt_DIR MATCHES "-NOTFOUND$"))
    foreach(_key IN ITEMS RNS8_HIPBLASLT_ROOT RNS8_HIP_ROOT)
      if(DEFINED ENV{${_key}} AND NOT "$ENV{${_key}}" STREQUAL "")
        set(_root "$ENV{${_key}}")
        break()
      endif()
    endforeach()
  endif()
  if(TARGET roc::hipblaslt)
    get_target_property(_incomplete roc::hipblaslt RNS8_DEPENDENCY_CONFIG_INCOMPLETE)
    if(_incomplete)
      set(${out_message} "An earlier hipBLASLt config import failed after creating its target; reconfigure with complete coherent dependencies" PARENT_SCOPE)
      return()
    endif()
  endif()
  if(_root)
    if(NOT IS_DIRECTORY "${_root}")
      set(${out_message} "Explicit hipBLASLt SDK root does not exist: ${_root}" PARENT_SCOPE)
      return()
    endif()
    file(REAL_PATH "${_root}" _root)
    file(TO_CMAKE_PATH "${_root}" _root)
    set(_comparison_root "${_root}")
    if(WIN32)
      string(TOLOWER "${_comparison_root}" _comparison_root)
    endif()
  endif()
  if(hipblaslt_DIR AND NOT hipblaslt_DIR MATCHES "-NOTFOUND$")
    if(NOT EXISTS "${hipblaslt_DIR}/hipblaslt-config.cmake" AND NOT EXISTS "${hipblaslt_DIR}/hipblasltConfig.cmake")
      set(${out_message} "Explicit hipblaslt_DIR has no config package: ${hipblaslt_DIR}" PARENT_SCOPE)
      return()
    endif()
    if(_root)
      file(REAL_PATH "${hipblaslt_DIR}" _directory)
      file(TO_CMAKE_PATH "${_directory}" _directory)
      if(WIN32)
        string(TOLOWER "${_directory}" _directory)
      endif()
      cmake_path(IS_PREFIX _comparison_root "${_directory}" NORMALIZE _within_root)
      if(NOT _within_root)
        set(${out_message} "hipblaslt_DIR is outside the selected SDK root; select coherent consumer roots or clear the stale package cache" PARENT_SCOPE)
        return()
      endif()
    endif()
  endif()
  if(NOT TARGET roc::hipblaslt)
    if(_root)
      find_package(hipblaslt CONFIG QUIET HINTS "${_root}"
        PATH_SUFFIXES lib/cmake/hipblaslt lib64/cmake/hipblaslt NO_DEFAULT_PATH)
    else()
      find_package(hipblaslt CONFIG QUIET)
    endif()
    if(NOT hipblaslt_FOUND)
      if(TARGET roc::hipblaslt)
        set_property(TARGET roc::hipblaslt PROPERTY RNS8_DEPENDENCY_CONFIG_INCOMPLETE TRUE)
      endif()
      set(${out_message} "hipBLASLt config package or its dependencies are unavailable: ${hipblaslt_NOT_FOUND_MESSAGE}. Set hipblaslt_DIR or RNS8_HIPBLASLT_ROOT; raw-library fallback is unsupported" PARENT_SCOPE)
      return()
    endif()
  endif()
  if(NOT TARGET roc::hipblaslt)
    set(${out_message} "hipBLASLt support requires a config package exporting roc::hipblaslt; set hipblaslt_DIR or RNS8_HIPBLASLT_ROOT for the consumer SDK. Raw-library fallback is unsupported" PARENT_SCOPE)
    return()
  endif()
  # An already imported target must not bypass an explicit current SDK root.
  if(_root)
    set(_paths)
    foreach(_property IN ITEMS IMPORTED_LOCATION IMPORTED_IMPLIB IMPORTED_LOCATION_RELEASE IMPORTED_IMPLIB_RELEASE
        IMPORTED_LOCATION_DEBUG IMPORTED_IMPLIB_DEBUG IMPORTED_LOCATION_RELWITHDEBINFO IMPORTED_IMPLIB_RELWITHDEBINFO
        IMPORTED_LOCATION_MINSIZEREL IMPORTED_IMPLIB_MINSIZEREL INTERFACE_INCLUDE_DIRECTORIES)
      get_target_property(_value roc::hipblaslt ${_property})
      if(_value AND NOT _value MATCHES "-NOTFOUND$")
        list(APPEND _paths ${_value})
      endif()
    endforeach()
    foreach(_path IN LISTS _paths)
      if(_path MATCHES "\\$<")
        continue() # Upstream owns its complete generator-expression interface.
      endif()
      file(REAL_PATH "${_path}" _path)
      file(TO_CMAKE_PATH "${_path}" _path)
      if(WIN32)
        string(TOLOWER "${_path}" _path)
      endif()
      cmake_path(IS_PREFIX _comparison_root "${_path}" NORMALIZE _within_root)
      if(NOT _within_root)
        set(${out_message} "roc::hipblaslt contains paths outside the selected consumer SDK root: ${_path}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
  endif()
  set(${out_found} TRUE PARENT_SCOPE)
  set(${out_message} "Found the consumer's upstream roc::hipblaslt target" PARENT_SCOPE)
endfunction()
