# Separate native-host detector/coverage artifacts from release and HIP builds.
set(RNS8_HOST_SANITIZER "none" CACHE STRING "Native Linux host detector: none, address-undefined, thread")
set_property(CACHE RNS8_HOST_SANITIZER PROPERTY STRINGS none address-undefined thread)
option(RNS8_ENABLE_HOST_COVERAGE "Instrument native Clang host objects with source branch coverage" OFF)
option(RNS8_BUILD_SANITIZER_CONTROLS "Build disposable host sanitizer detector controls" OFF)
option(RNS8_ENABLE_DEVICE_ASAN "Separate native Linux ROCm GPU address-sanitizer candidate" OFF)
set(RNS8_DEVICE_ASAN_ROCM_VERSION "" CACHE STRING "Exact official device-ASan ROCm release")
set(RNS8_DEVICE_ASAN_COMPILE_FLAGS "")
set(RNS8_DEVICE_ASAN_LINK_FLAGS "")
if(RNS8_ENABLE_DEVICE_ASAN)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang" OR CMAKE_CROSSCOMPILING OR NOT RNS8_ENABLE_HIP)
    message(FATAL_ERROR "Device ASan requires a separate native Linux AMD Clang/HIP build")
  endif()
  if(NOT RNS8_DEVICE_ASAN_ROCM_VERSION STREQUAL "10.1.0" OR NOT RNS8_AMDGPU_TARGETS MATCHES "^gfx(942|950):xnack[+]$")
    message(FATAL_ERROR "Reviewed ROCm10.1 GPU-ASan packages cover one gfx942:xnack+ or gfx950:xnack+ target; other tuples require a new policy")
  endif()
  if(NOT RNS8_HOST_SANITIZER STREQUAL "none" OR RNS8_ENABLE_HOST_COVERAGE OR RNS8_ENABLE_WINDOWS_CLANG_ASAN OR RNS8_BUILD_FUZZERS OR RNS8_BUILD_SANITIZER_CONTROLS OR RNS8_ENABLE_CPU_PARALLEL)
    message(FATAL_ERROR "Device ASan cannot share host detector/coverage/fuzzer/OpenMP qualification identities")
  endif()
  # Both ordinary first-party host objects and the explicit HIP compiler argv
  # need instrumentation. Neither selector alone establishes device coverage.
  set(RNS8_DEVICE_ASAN_COMPILE_FLAGS -fsanitize=address -shared-libsan -fno-sanitize-recover=address -fno-omit-frame-pointer -g)
  set(RNS8_DEVICE_ASAN_LINK_FLAGS -fsanitize=address -shared-libsan -fno-sanitize-recover=address)
  add_compile_options(${RNS8_DEVICE_ASAN_COMPILE_FLAGS})
  add_link_options(${RNS8_DEVICE_ASAN_LINK_FLAGS})
  set(CMAKE_EXPORT_COMPILE_COMMANDS ON CACHE BOOL "Export instrumented first-party commands" FORCE)
endif()
if(NOT RNS8_HOST_SANITIZER MATCHES "^(none|address-undefined|thread)$")
  message(FATAL_ERROR "Unknown RNS8_HOST_SANITIZER; select none, address-undefined or thread")
endif()
set(RNS8_HOST_INSTRUMENTATION_COMPILE_FLAGS "")
set(RNS8_HOST_INSTRUMENTATION_LINK_FLAGS "")
if(NOT RNS8_HOST_SANITIZER STREQUAL "none" OR RNS8_ENABLE_HOST_COVERAGE)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang" OR CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "Native host sanitizer/coverage lanes require Linux Clang; Windows keeps its existing clang-cl ASan owner")
  endif()
  if(RNS8_ENABLE_HIP OR RNS8_ENABLE_WINDOWS_CLANG_ASAN)
    message(FATAL_ERROR "Host instrumentation does not instrument HIP device objects; select a separate CPU build tree")
  endif()
  if(RNS8_ENABLE_HOST_COVERAGE AND NOT RNS8_HOST_SANITIZER STREQUAL "none")
    message(FATAL_ERROR "Coverage and sanitizers require separate source/build identities")
  endif()
  if(RNS8_HOST_SANITIZER STREQUAL "thread" AND RNS8_BUILD_FUZZERS)
    message(FATAL_ERROR "TSan cannot share the ASan/libFuzzer object lane")
  endif()
  if(RNS8_ENABLE_HOST_COVERAGE AND RNS8_BUILD_FUZZERS)
    message(FATAL_ERROR "Source coverage and libFuzzer instrumentation require separate objects")
  endif()
  if(RNS8_HOST_SANITIZER STREQUAL "address-undefined")
    set(RNS8_HOST_INSTRUMENTATION_COMPILE_FLAGS -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
    set(RNS8_HOST_INSTRUMENTATION_LINK_FLAGS -fsanitize=address,undefined -fno-sanitize-recover=all)
  elseif(RNS8_HOST_SANITIZER STREQUAL "thread")
    set(RNS8_HOST_INSTRUMENTATION_COMPILE_FLAGS -fsanitize=thread -fno-omit-frame-pointer)
    set(RNS8_HOST_INSTRUMENTATION_LINK_FLAGS -fsanitize=thread)
  elseif(RNS8_ENABLE_HOST_COVERAGE)
    set(RNS8_HOST_INSTRUMENTATION_COMPILE_FLAGS -fprofile-instr-generate -fcoverage-mapping)
    set(RNS8_HOST_INSTRUMENTATION_LINK_FLAGS -fprofile-instr-generate -Wl,--build-id=sha1)
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/profiles")
  endif()
  add_compile_options(${RNS8_HOST_INSTRUMENTATION_COMPILE_FLAGS})
  add_link_options(${RNS8_HOST_INSTRUMENTATION_LINK_FLAGS})
  set(CMAKE_EXPORT_COMPILE_COMMANDS ON CACHE BOOL "Export instrumented first-party commands" FORCE)
endif()
if(RNS8_BUILD_SANITIZER_CONTROLS AND RNS8_HOST_SANITIZER STREQUAL "none" AND NOT RNS8_ENABLE_WINDOWS_CLANG_ASAN)
  message(FATAL_ERROR "Detector controls require a selected instrumented host lane")
endif()
