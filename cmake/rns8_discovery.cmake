# Run before project(): selecting a toolchain after compiler detection is too late.
# The existing doctor owns resolution. CMake only serializes inputs and consumes
# its versioned JSON; it does not implement a second candidate search.
set(_rns8_discovery_source "${CMAKE_CURRENT_LIST_DIR}/..")
get_filename_component(_rns8_discovery_source "${_rns8_discovery_source}" ABSOLUTE)
if(Python3_EXECUTABLE)
  set(_rns8_discovery_python "${Python3_EXECUTABLE}")
else()
  find_program(_rns8_discovery_python NAMES python3 python NO_CMAKE_FIND_ROOT_PATH)
endif()
if(NOT _rns8_discovery_python)
  message(FATAL_ERROR "RNS8 dependency discovery requires host Python3. Set -DPython3_EXECUTABLE=/path/to/python3; see https://www.python.org/downloads/")
endif()

function(_rns8_json_string out value)
  string(REPLACE "\\" "\\\\" _text "${value}")
  string(REPLACE "\"" "\\\"" _text "${_text}")
  string(REPLACE "\n" "\\n" _text "${_text}")
  string(REPLACE "\r" "\\r" _text "${_text}")
  string(REPLACE "\t" "\\t" _text "${_text}")
  set(${out} "\"${_text}\"" PARENT_SCOPE)
endfunction()

set(_rns8_request "{\"overrides\":{},\"features\":{}}")
set(_rns8_host "${CMAKE_HOST_SYSTEM_NAME}")
if(RNS8_FORCE_LINUX_NATIVE_DISCOVERY_GUARD)
  set(_rns8_host "Linux")
endif()
_rns8_json_string(_rns8_value "${_rns8_host}")
string(JSON _rns8_request SET "${_rns8_request}" host "${_rns8_value}")
_rns8_json_string(_rns8_value "${_rns8_discovery_source}")
string(JSON _rns8_request SET "${_rns8_request}" source_root "${_rns8_value}")
set(_rns8_input_variables
  RNS8_HIP_ROOT RNS8_HIP_HIPCC RNS8_HIP_INCLUDE_DIR RNS8_HIP_LIBRARY RNS8_HIP_RUNTIME RNS8_HIP_DEVICE_LIB_DIR RNS8_HIP_CLANG
  RNS8_CK_ROOT RNS8_ROCWMMA_ROOT RNS8_HIPBLASLT_ROOT RNS8_GMP_ROOT RNS8_FLINT_ROOT
  RNS8_CK_INCLUDE_DIR RNS8_ROCWMMA_INCLUDE_DIR RNS8_HIPBLASLT_INCLUDE_DIR RNS8_HIPBLASLT_LIBRARY hipblaslt_DIR
  RNS8_GMP_INCLUDE_DIR RNS8_GMP_LIBRARY RNS8_FLINT_INCLUDE_DIR RNS8_FLINT_LIBRARY
  CMAKE_TOOLCHAIN_FILE VCPKG_ROOT VCPKG_TARGET_TRIPLET CMAKE_PREFIX_PATH CMAKE_INCLUDE_PATH CMAKE_LIBRARY_PATH
  CMAKE_SYSROOT CMAKE_CXX_COMPILER CMAKE_SYSTEM_NAME CMAKE_SYSTEM_PROCESSOR CMAKE_FIND_ROOT_PATH CMAKE_FIND_ROOT_PATH_MODE_PACKAGE
  RNS8_AMDGPU_TARGETS RNS8_ROCM_DEPS_INSTALL_ROOT RNS8_ROCM_DEPS_BUILD_ROOT)
foreach(_rns8_variable IN LISTS _rns8_input_variables)
  if(DEFINED ${_rns8_variable} AND NOT "${${_rns8_variable}}" STREQUAL "" AND NOT "${${_rns8_variable}}" MATCHES "-NOTFOUND$")
    set(_rns8_input "${${_rns8_variable}}")
    if(CMAKE_HOST_WIN32)
      # Keep user cache inputs safe for macro-based package/toolchain wrappers,
      # including path lists that do not receive a selected binding below.
      string(REPLACE "\\" "/" _rns8_input "${_rns8_input}")
      set(${_rns8_variable} "${_rns8_input}")
    endif()
    if(_rns8_variable STREQUAL "CMAKE_TOOLCHAIN_FILE" AND NOT IS_ABSOLUTE "${_rns8_input}")
      if(EXISTS "${CMAKE_CURRENT_BINARY_DIR}/${_rns8_input}")
        get_filename_component(_rns8_input "${CMAKE_CURRENT_BINARY_DIR}/${_rns8_input}" ABSOLUTE)
      elseif(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/${_rns8_input}")
        get_filename_component(_rns8_input "${CMAKE_CURRENT_SOURCE_DIR}/${_rns8_input}" ABSOLUTE)
      endif()
    endif()
    _rns8_json_string(_rns8_value "${_rns8_input}")
    string(JSON _rns8_request SET "${_rns8_request}" overrides "${_rns8_variable}" "${_rns8_value}")
  endif()
endforeach()
foreach(_rns8_variable IN ITEMS RNS8_ENABLE_HIP RNS8_ENABLE_CK RNS8_ENABLE_ROCWMMA RNS8_ENABLE_HIPBLASLT
    RNS8_ENABLE_GMP RNS8_ENABLE_FLINT RNS8_ENABLE_AMDGPU_BUILTINS RNS8_PROBE_ACCELERATORS)
  if(${_rns8_variable})
    set(_rns8_boolean true)
  else()
    set(_rns8_boolean false)
  endif()
  string(JSON _rns8_request SET "${_rns8_request}" features "${_rns8_variable}" ${_rns8_boolean})
endforeach()
if(RNS8_ENABLE_HIP)
  string(JSON _rns8_request SET "${_rns8_request}" require_hip true)
else()
  string(JSON _rns8_request SET "${_rns8_request}" require_hip false)
endif()
if(_rns8_host STREQUAL "Windows")
  string(JSON _rns8_request SET "${_rns8_request}" require_vcpkg true)
else()
  string(JSON _rns8_request SET "${_rns8_request}" require_vcpkg false)
endif()

file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/dependency-discovery")
set(_rns8_request_path "${CMAKE_CURRENT_BINARY_DIR}/dependency-discovery/request.json")
set(RNS8_DISCOVERY_REPORT "${CMAKE_CURRENT_BINARY_DIR}/dependency-discovery/resolution.json" CACHE INTERNAL "Shared dependency discovery evidence")
file(WRITE "${_rns8_request_path}" "${_rns8_request}\n")
execute_process(COMMAND "${_rns8_discovery_python}" "${_rns8_discovery_source}/tools/check_dependencies.py"
  --resolve-only --json --resolution-request "${_rns8_request_path}"
  WORKING_DIRECTORY "${_rns8_discovery_source}"
  OUTPUT_VARIABLE _rns8_resolution ERROR_VARIABLE _rns8_resolution_error RESULT_VARIABLE _rns8_resolution_status TIMEOUT 30)
file(WRITE "${RNS8_DISCOVERY_REPORT}" "${_rns8_resolution}")
if(NOT _rns8_resolution_status EQUAL 0)
  string(JSON _rns8_error_count ERROR_VARIABLE _rns8_json_error LENGTH "${_rns8_resolution}" errors)
  set(_rns8_error_summary "${_rns8_resolution_error}")
  if(NOT _rns8_json_error AND _rns8_error_count GREATER 0)
    math(EXPR _rns8_error_last "${_rns8_error_count}-1")
    foreach(_rns8_error_index RANGE 0 ${_rns8_error_last})
      string(JSON _rns8_error GET "${_rns8_resolution}" errors ${_rns8_error_index})
      string(APPEND _rns8_error_summary "\n${_rns8_error}")
    endforeach()
  endif()
  message(FATAL_ERROR "RNS8 shared dependency resolution failed. Select explicit roots/toolchain; full evidence: ${RNS8_DISCOVERY_REPORT}\n${_rns8_error_summary}")
endif()
string(JSON _rns8_schema GET "${_rns8_resolution}" schema)
if(NOT _rns8_schema STREQUAL "rns8_dependency_resolution_v1")
  message(FATAL_ERROR "Unsupported RNS8 dependency resolution schema: ${_rns8_schema}")
endif()
string(JSON _rns8_identity GET "${_rns8_resolution}" identity_sha256)
set(RNS8_DISCOVERY_IDENTITY_SHA256 "${_rns8_identity}" CACHE INTERNAL "Shared dependency selection identity")
string(JSON _rns8_count LENGTH "${_rns8_resolution}" cmake_bindings)
if(_rns8_count GREATER 0)
  math(EXPR _rns8_last "${_rns8_count}-1")
  foreach(_rns8_index RANGE 0 ${_rns8_last})
    string(JSON _rns8_variable MEMBER "${_rns8_resolution}" cmake_bindings ${_rns8_index})
    string(JSON _rns8_binding GET "${_rns8_resolution}" cmake_bindings "${_rns8_variable}")
    set(${_rns8_variable} "${_rns8_binding}" CACHE STRING "Selected by shared RNS8 dependency discovery" FORCE)
  endforeach()
endif()
if(RNS8_ENABLE_HIP)
  set(_rns8_hip_environment "")
  foreach(_rns8_name IN ITEMS HIP_PATH ROCM_PATH HIP_CLANG_PATH HIP_DEVICE_LIB_PATH)
    string(JSON _rns8_env_value GET "${_rns8_resolution}" compiler_environment "${_rns8_name}")
    list(APPEND _rns8_hip_environment "${_rns8_name}=${_rns8_env_value}")
    set(ENV{${_rns8_name}} "${_rns8_env_value}")
  endforeach()
  set(RNS8_HIP_COMPILER_ENVIRONMENT "${_rns8_hip_environment}" CACHE INTERNAL "Selected SDK environment for compiler child processes")
  get_filename_component(_rns8_hip_prefix "${RNS8_HIP_INCLUDE_DIR}" DIRECTORY)
  set(RNS8_HIP_COMMON_FLAGS "--hip-path=${_rns8_hip_prefix};--hip-device-lib-path=${RNS8_HIP_DEVICE_LIB_DIR}"
      CACHE INTERNAL "Selected SDK compiler path flags")
endif()
# Discovery/configure is not permission to bootstrap/download missing packages.
# A user can deliberately select the existing vcpkg install workflow separately.
set(VCPKG_MANIFEST_INSTALL OFF CACHE BOOL "Install vcpkg manifest packages during configure (explicit opt-in only)")
set(Python3_EXECUTABLE "${_rns8_discovery_python}" CACHE FILEPATH "Selected host Python interpreter")
message(STATUS "RNS8 dependency selection ${RNS8_DISCOVERY_IDENTITY_SHA256}; evidence ${RNS8_DISCOVERY_REPORT}")
