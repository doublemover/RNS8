include_guard(GLOBAL)
# Shared by build-tree discovery and installed consumers. Do not embed producer
# machine paths: the consumer supplies its own coherent SDK/package selection.
function(rns8_resolve_sdk_package package target root_keys out_found out_message)
  set(${out_found} FALSE PARENT_SCOPE)
  set(_root "")
  set(_package_directory "${${package}_DIR}")
  foreach(_key IN LISTS root_keys)
    if(${_key})
      set(_root "${${_key}}")
      break()
    endif()
  endforeach()
  if(NOT _root AND (NOT _package_directory OR _package_directory MATCHES "-NOTFOUND$"))
    foreach(_key IN LISTS root_keys)
      if(DEFINED ENV{${_key}} AND NOT "$ENV{${_key}}" STREQUAL "")
        set(_root "$ENV{${_key}}")
        break()
      endif()
    endforeach()
  endif()
  if(TARGET ${target})
    get_target_property(_incomplete ${target} RNS8_DEPENDENCY_CONFIG_INCOMPLETE)
    if(_incomplete)
      set(${out_message} "An earlier ${package} config import failed after creating its target; reconfigure with complete coherent dependencies" PARENT_SCOPE)
      return()
    endif()
  endif()
  if(_root)
    if(NOT IS_DIRECTORY "${_root}")
      set(${out_message} "Explicit ${package} SDK root does not exist: ${_root}" PARENT_SCOPE)
      return()
    endif()
    file(REAL_PATH "${_root}" _root)
    file(TO_CMAKE_PATH "${_root}" _root)
    set(_comparison_root "${_root}")
    if(WIN32)
      string(TOLOWER "${_comparison_root}" _comparison_root)
    endif()
  endif()
  if(_package_directory AND NOT _package_directory MATCHES "-NOTFOUND$")
    if(NOT EXISTS "${_package_directory}/${package}-config.cmake" AND NOT EXISTS "${_package_directory}/${package}Config.cmake")
      set(${out_message} "Explicit ${package}_DIR has no config package: ${_package_directory}" PARENT_SCOPE)
      return()
    endif()
    if(_root)
      file(REAL_PATH "${_package_directory}" _directory)
      file(TO_CMAKE_PATH "${_directory}" _directory)
      if(WIN32)
        string(TOLOWER "${_directory}" _directory)
      endif()
      cmake_path(IS_PREFIX _comparison_root "${_directory}" NORMALIZE _within_root)
      if(NOT _within_root)
        set(${out_message} "${package}_DIR is outside the selected SDK root; select coherent consumer roots or clear the stale package cache" PARENT_SCOPE)
        return()
      endif()
    endif()
  endif()
  if(NOT TARGET ${target})
    if(_root)
      find_package(${package} CONFIG QUIET HINTS "${_root}"
        PATH_SUFFIXES lib/cmake/${package} lib64/cmake/${package} NO_DEFAULT_PATH)
    else()
      find_package(${package} CONFIG QUIET)
    endif()
    if(NOT ${package}_FOUND)
      if(TARGET ${target})
        set_property(TARGET ${target} PROPERTY RNS8_DEPENDENCY_CONFIG_INCOMPLETE TRUE)
      endif()
      set(${out_message} "${package} config package or its dependencies are unavailable: ${${package}_NOT_FOUND_MESSAGE}. Set ${package}_DIR or ${root_keys}; raw-library fallback is unsupported" PARENT_SCOPE)
      return()
    endif()
  endif()
  if(NOT TARGET ${target})
    set(${out_message} "${package} support requires a config package exporting ${target}; set ${package}_DIR or ${root_keys} for the consumer SDK. Raw-library fallback is unsupported" PARENT_SCOPE)
    return()
  endif()
  if(package STREQUAL "hip" AND NOT TARGET hip::amdhip64)
    set(${out_message} "RNS8 requires an AMD HIP package exporting hip::amdhip64, not a different HIP runtime platform" PARENT_SCOPE)
    return()
  endif()
  # An already imported target must not bypass an explicit current SDK root.
  if(_root)
    set(_paths)
    set(_validation_targets "${target}")
    if(package STREQUAL "hip" AND TARGET hip::amdhip64)
      list(APPEND _validation_targets hip::amdhip64)
    endif()
    foreach(_validation_target IN LISTS _validation_targets)
      foreach(_property IN ITEMS IMPORTED_LOCATION IMPORTED_IMPLIB IMPORTED_LOCATION_RELEASE IMPORTED_IMPLIB_RELEASE
          IMPORTED_LOCATION_DEBUG IMPORTED_IMPLIB_DEBUG IMPORTED_LOCATION_RELWITHDEBINFO IMPORTED_IMPLIB_RELWITHDEBINFO
          IMPORTED_LOCATION_MINSIZEREL IMPORTED_IMPLIB_MINSIZEREL INTERFACE_INCLUDE_DIRECTORIES)
        get_target_property(_value ${_validation_target} ${_property})
        if(_value AND NOT _value MATCHES "-NOTFOUND$")
          list(APPEND _paths ${_value})
        endif()
      endforeach()
    endforeach()
    foreach(_path IN LISTS _paths)
      if(_path MATCHES "\\$<")
        continue() # Upstream owns its complete generator-expression interface.
      endif()
      file(REAL_PATH "${_path}" _path)
      file(TO_CMAKE_PATH "${_path}" _path)
      if(WIN32)
        string(TOLOWER "${_path}" _path)
      endif()
      cmake_path(IS_PREFIX _comparison_root "${_path}" NORMALIZE _within_root)
      if(NOT _within_root)
        set(${out_message} "${target} contains paths outside the selected consumer SDK root: ${_path}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
  endif()
  set(${out_found} TRUE PARENT_SCOPE)
  set(${out_message} "Found the consumer's upstream ${target} target" PARENT_SCOPE)
endfunction()
