# First-party diagnostics stay private; exported consumers own their warnings.
option(RNS8_WARNINGS_AS_ERRORS "Treat first-party host compiler warnings as errors" OFF)

function(rns8_private_warnings_in_directory directory)
  file(RELATIVE_PATH _owner "${PROJECT_SOURCE_DIR}" "${directory}")
  if(NOT _owner STREQUAL "" AND NOT _owner STREQUAL "." AND
      NOT _owner MATCHES "^(src|include|tools|tests|benchmarks|examples)(/|$)")
    return()
  endif()
  get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(_target IN LISTS _targets)
    get_target_property(_imported ${_target} IMPORTED)
    get_target_property(_type ${_target} TYPE)
    if(_imported OR NOT _type MATCHES "^(STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY|EXECUTABLE)$")
      continue()
    endif()
    if(MSVC)
      target_compile_options(${_target} PRIVATE /W4 "$<$<COMPILE_LANGUAGE:CXX>:/permissive->")
      if(RNS8_ENABLE_HIP)
        # Preserve the existing HIP vector-header exception, not a public flag.
        target_compile_options(${_target} PRIVATE /wd4201)
      endif()
      if(RNS8_WARNINGS_AS_ERRORS)
        target_compile_options(${_target} PRIVATE /WX)
      endif()
    else()
      target_compile_options(${_target} PRIVATE -Wall -Wextra -Wpedantic)
      if(RNS8_WARNINGS_AS_ERRORS)
        target_compile_options(${_target} PRIVATE -Werror)
      endif()
    endif()
    set_property(TARGET ${_target} PROPERTY RNS8_PRIVATE_WARNING_POLICY "first-party-v1")
  endforeach()
  get_property(_children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(_child IN LISTS _children)
    rns8_private_warnings_in_directory("${_child}")
  endforeach()
endfunction()

function(rns8_json_string out value)
  string(REPLACE "\\" "\\\\" _escaped "${value}")
  string(REPLACE "\"" "\\\"" _escaped "${_escaped}")
  string(REPLACE "\n" "\\n" _escaped "${_escaped}")
  string(REPLACE "\r" "\\r" _escaped "${_escaped}")
  string(REPLACE "\t" "\\t" _escaped "${_escaped}")
  set(${out} "\"${_escaped}\"" PARENT_SCOPE)
endfunction()

function(rns8_json_array out list_variable)
  set(_json "[]")
  set(_index 0)
  foreach(_value IN LISTS ${list_variable})
    rns8_json_string(_quoted "${_value}")
    string(JSON _json SET "${_json}" ${_index} "${_quoted}")
    math(EXPR _index "${_index}+1")
  endforeach()
  set(${out} "${_json}" PARENT_SCOPE)
endfunction()

function(rns8_record_hip_compile source object compiler_args environment generated_inputs)
  set(_record "{}")
  foreach(_field IN ITEMS directory file output configuration)
    if(_field STREQUAL "directory")
      set(_value "${CMAKE_CURRENT_BINARY_DIR}")
    elseif(_field STREQUAL "file")
      set(_value "${source}")
    elseif(_field STREQUAL "output")
      set(_value "${object}")
    else()
      set(_value "${CMAKE_BUILD_TYPE}")
    endif()
    rns8_json_string(_quoted "${_value}")
    string(JSON _record SET "${_record}" "${_field}" "${_quoted}")
  endforeach()
  foreach(_field IN ITEMS arguments environment generated_inputs targets)
    if(_field STREQUAL "arguments")
      set(_values "${compiler_args}")
    elseif(_field STREQUAL "environment")
      set(_values "${environment}")
    elseif(_field STREQUAL "generated_inputs")
      set(_values "${generated_inputs}")
    else()
      set(_values "${RNS8_AMDGPU_TARGETS}")
    endif()
    rns8_json_array(_array _values)
    string(JSON _record SET "${_record}" "${_field}" "${_array}")
  endforeach()
  # JSON strings can contain semicolons; keep only safe keys in CMake lists.
  string(SHA256 _key "${_record}")
  set_property(GLOBAL PROPERTY RNS8_HIP_COMPILE_RECORD_${_key} "${_record}")
  set_property(GLOBAL APPEND PROPERTY RNS8_HIP_COMPILE_RECORD_KEYS "${_key}")
endfunction()

function(rns8_write_analysis_metadata)
  set(_document "{\"schema\":\"rns8_custom_hip_compile_commands_v1\",\"scope\":\"configured_commands_not_executed_compiler_receipts\",\"commands\":[]}")
  get_property(_keys GLOBAL PROPERTY RNS8_HIP_COMPILE_RECORD_KEYS)
  set(_index 0)
  foreach(_key IN LISTS _keys)
    get_property(_record GLOBAL PROPERTY RNS8_HIP_COMPILE_RECORD_${_key})
    string(JSON _document SET "${_document}" commands ${_index} "${_record}")
    math(EXPR _index "${_index}+1")
  endforeach()
  file(WRITE "${CMAKE_BINARY_DIR}/rns8-hip-compile-commands.json" "${_document}\n")
endfunction()
