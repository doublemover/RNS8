@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(RNS8_ENABLE_HIP @RNS8_ENABLE_HIP@)
set(RNS8_ENABLE_HIPBLASLT @RNS8_ENABLE_HIPBLASLT@)
set(RNS8_ENABLE_CK @RNS8_ENABLE_CK@)
set(RNS8_ENABLE_ROCWMMA @RNS8_ENABLE_ROCWMMA@)
set(RNS8_CPU_PARALLEL_OPENMP @RNS8_CPU_PARALLEL_OPENMP@)
set(RNS8_HIPBLASLT_TARGET "@RNS8_HIPBLASLT_TARGET@")
set(RNS8_HIPBLASLT_INCLUDE_DIR "@RNS8_HIPBLASLT_INCLUDE_DIR@")
set(RNS8_HIPBLASLT_LIBRARY "@RNS8_HIPBLASLT_LIBRARY@")

if(RNS8_CPU_PARALLEL_OPENMP AND NOT TARGET OpenMP::OpenMP_CXX)
  find_dependency(OpenMP COMPONENTS CXX REQUIRED)
endif()

if(RNS8_ENABLE_HIPBLASLT AND RNS8_HIPBLASLT_TARGET STREQUAL "roc::hipblaslt" AND NOT TARGET roc::hipblaslt)
  find_dependency(hipblaslt CONFIG QUIET)
  if(NOT TARGET roc::hipblaslt AND RNS8_HIPBLASLT_LIBRARY)
    add_library(roc::hipblaslt UNKNOWN IMPORTED)
    set_target_properties(roc::hipblaslt PROPERTIES IMPORTED_LOCATION "${RNS8_HIPBLASLT_LIBRARY}")
    if(RNS8_HIPBLASLT_INCLUDE_DIR)
      set_target_properties(
        roc::hipblaslt
        PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${RNS8_HIPBLASLT_INCLUDE_DIR}"
      )
    endif()
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/RNS8Targets.cmake")

check_required_components(RNS8)
