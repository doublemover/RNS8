@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
include("${CMAKE_CURRENT_LIST_DIR}/RNS8Runtime.cmake")
set(RNS8_WINDOWS_RUNTIME_DLLS "")
set(_rns8_runtime_names "@RNS8_WINDOWS_RUNTIME_NAMES@")
foreach(_runtime IN LISTS _rns8_runtime_names)
  list(APPEND RNS8_WINDOWS_RUNTIME_DLLS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/${_runtime}")
endforeach()

set(RNS8_ENABLE_HIP @RNS8_ENABLE_HIP@)
set(RNS8_ENABLE_HIPBLASLT @RNS8_ENABLE_HIPBLASLT@)
set(RNS8_ENABLE_CK @RNS8_ENABLE_CK@)
set(RNS8_ENABLE_ROCWMMA @RNS8_ENABLE_ROCWMMA@)
set(RNS8_CPU_PARALLEL_OPENMP @RNS8_CPU_PARALLEL_OPENMP@)

if(RNS8_CPU_PARALLEL_OPENMP AND NOT TARGET OpenMP::OpenMP_CXX)
  find_dependency(OpenMP COMPONENTS CXX REQUIRED)
endif()

if(RNS8_ENABLE_HIP AND NOT TARGET RNS8::hip_runtime)
  if(WIN32)
    set(_rns8_hip_import "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/rns8-dependencies/@RNS8_HIP_IMPORT_LIBRARY_NAME@")
    set(_rns8_hip_runtime "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/@RNS8_HIP_RUNTIME_NAME@")
    if(NOT EXISTS "${_rns8_hip_import}" OR NOT EXISTS "${_rns8_hip_runtime}")
      set(RNS8_FOUND FALSE)
      set(RNS8_NOT_FOUND_MESSAGE "RNS8 HIP package requires its matching installed import library and runtime DLL; install both Development and Runtime components")
      return()
    endif()
    add_library(RNS8::hip_runtime SHARED IMPORTED)
    set_target_properties(RNS8::hip_runtime PROPERTIES IMPORTED_IMPLIB "${_rns8_hip_import}" IMPORTED_LOCATION "${_rns8_hip_runtime}")
  else()
    include("${CMAKE_CURRENT_LIST_DIR}/RNS8SDKPackageDependency.cmake")
    rns8_resolve_sdk_package(hip hip::host "RNS8_HIP_ROOT" _rns8_hip_found _rns8_hip_message)
    if(NOT _rns8_hip_found)
      set(RNS8_FOUND FALSE)
      set(RNS8_NOT_FOUND_MESSAGE "${_rns8_hip_message}")
      return()
    endif()
    add_library(RNS8::hip_runtime INTERFACE IMPORTED)
    set_target_properties(RNS8::hip_runtime PROPERTIES INTERFACE_LINK_LIBRARIES hip::host)
  endif()
endif()

if(RNS8_ENABLE_HIPBLASLT)
  include("${CMAKE_CURRENT_LIST_DIR}/RNS8SDKPackageDependency.cmake")
  rns8_resolve_sdk_package(hipblaslt roc::hipblaslt "RNS8_HIPBLASLT_ROOT;RNS8_HIP_ROOT" _rns8_lt_found _rns8_lt_message)
  if(NOT _rns8_lt_found)
    set(RNS8_FOUND FALSE)
    set(RNS8_NOT_FOUND_MESSAGE "${_rns8_lt_message}")
    return()
  endif()
endif()

if(@RNS8_ENABLE_DISTRIBUTED_MPI@)
  find_dependency(MPI 3.0 COMPONENTS CXX REQUIRED)
endif()
if(@RNS8_ENABLE_RCCL@ AND NOT TARGET RNS8::rccl_transport)
  find_library(_rns8_rccl_runtime NAMES rccl HINTS /opt/rocm/lib REQUIRED)
  add_library(RNS8::rccl_transport UNKNOWN IMPORTED)
  set_target_properties(RNS8::rccl_transport PROPERTIES IMPORTED_LOCATION "${_rns8_rccl_runtime}")
endif()
if(@RNS8_ENABLE_ROCSHMEM@ AND NOT TARGET RNS8::rocshmem_transport)
  add_library(RNS8::rocshmem_transport SHARED IMPORTED)
  set_target_properties(RNS8::rocshmem_transport PROPERTIES
    IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/librns8-rocshmem-transport.so")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/RNS8Targets.cmake")

check_required_components(RNS8)
