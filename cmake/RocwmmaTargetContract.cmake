include_guard(GLOBAL)

# The current package has one host launch width. Direct HIP can still package
# mixed targets; this restriction applies only when rocWMMA is requested.
function(rns8_rocwmma_target_contract output)
  set(_wave "")
  foreach(_target IN LISTS ARGN)
    if(NOT _target MATCHES "^(gfx[0-9a-f]+)(:(xnack|sramecc)[+-])*$")
      message(FATAL_ERROR "Malformed rocWMMA target: ${_target}")
    endif()
    string(REGEX REPLACE ":.*$" "" _base "${_target}")
    if(_base MATCHES "^(gfx908|gfx90a|gfx940|gfx941|gfx942|gfx950)$")
      set(_candidate 64)
    elseif(_base MATCHES "^(gfx1100|gfx1101|gfx1102|gfx1200|gfx1201)$")
      set(_candidate 32)
    else()
      message(FATAL_ERROR "rocWMMA has no admitted lowering for target ${_target}")
    endif()
    if(_wave AND NOT _wave EQUAL _candidate)
      message(FATAL_ERROR
        "rocWMMA cannot package mixed wave32/wave64 targets (${ARGN}) with one host launch width. Use separate rocWMMA builds or disable this optional backend for a mixed direct-HIP package.")
    endif()
    set(_wave ${_candidate})
  endforeach()
  if(NOT _wave)
    message(FATAL_ERROR "rocWMMA requires an explicit nonempty target list")
  endif()
  set(${output} ${_wave} PARENT_SCOPE)
endfunction()
