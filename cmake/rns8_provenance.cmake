find_package(Python3 COMPONENTS Interpreter REQUIRED)
set(RNS8_MANIFEST_HEADER "${CMAKE_CURRENT_BINARY_DIR}/generated/$<CONFIG>/rns8_build_manifest.hpp")
function(rns8_generate_manifest_configuration)
  set(_overlay_hash "none")
  if(RNS8_HIP_STL_OVERLAY)
    file(SHA256 "${RNS8_HIP_STL_OVERLAY}/__clang_hip_runtime_wrapper.h" _overlay_hash)
  endif()
  # Bind enabled accelerator headers, including build-local CK adaptations.
  # These may live in a different checkout and are not covered by our git SHA.
  set(_dependency_trees "")
  foreach(_runtime IN LISTS RNS8_WINDOWS_RUNTIME_DLLS)
    file(SHA256 "${_runtime}" _runtime_hash)
    get_filename_component(_runtime_name "${_runtime}" NAME)
    string(APPEND _dependency_trees "runtime_${_runtime_name}_sha256=${_runtime_hash}\n")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_runtime}")
  endforeach()
  if(RNS8_ENABLE_CK)
    string(APPEND _dependency_trees "ck_wmma_signed_inputs=${RNS8_CK_WMMA_SIGNED_INPUTS}\n")
  endif()
  file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/metadata/dependencies.json" _dependency_policy_hash)
  file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/scripts/requirements-build-tools.txt" _bootstrap_requirements_hash)
  string(APPEND _dependency_trees "dependency_policy_sha256=${_dependency_policy_hash}\nbootstrap_requirements_sha256=${_bootstrap_requirements_hash}\n")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/metadata/dependencies.json"
    "${CMAKE_CURRENT_SOURCE_DIR}/scripts/requirements-build-tools.txt")
  if(NOT IS_DIRECTORY "${RNS8_BOOST_MULTIPRECISION_INCLUDE_DIR}/boost")
    message(FATAL_ERROR "Selected Boost include tree is missing from build identity")
  endif()
  string(APPEND _dependency_trees "dependency_tree.BOOST=${RNS8_BOOST_MULTIPRECISION_INCLUDE_DIR}/boost\n")
  set(_json_count 0)
  foreach(_include IN LISTS RNS8_NLOHMANN_JSON_INCLUDE_DIRS)
    if(IS_DIRECTORY "${_include}/nlohmann")
      math(EXPR _json_count "${_json_count}+1")
      string(APPEND _dependency_trees "dependency_tree.JSON_${_json_count}=${_include}/nlohmann\n")
    endif()
  endforeach()
  if(_json_count EQUAL 0)
    message(FATAL_ERROR "Selected nlohmann-json include tree is missing from build identity")
  endif()
  if(TARGET Catch2::Catch2)
    get_target_property(_catch2_includes Catch2::Catch2 INTERFACE_INCLUDE_DIRECTORIES)
    set(_catch2_count 0)
    foreach(_include IN LISTS _catch2_includes)
      if(IS_DIRECTORY "${_include}/catch2")
        math(EXPR _catch2_count "${_catch2_count}+1")
        string(APPEND _dependency_trees "dependency_tree.CATCH2_${_catch2_count}=${_include}/catch2\n")
      endif()
    endforeach()
    if(_catch2_count EQUAL 0)
      message(FATAL_ERROR "Selected Catch2 include tree is missing from test build identity")
    endif()
  endif()
  if(RNS8_DISCOVERY_IDENTITY_SHA256)
    string(APPEND _dependency_trees "dependency_resolution_sha256=${RNS8_DISCOVERY_IDENTITY_SHA256}\n")
  else()
    string(APPEND _dependency_trees "dependency_resolution_sha256=unavailable_no_shared_resolution\n")
  endif()
  foreach(_backend IN ITEMS ROCWMMA CK HIPBLASLT RCCL ROCSHMEM)
    if(RNS8_ENABLE_${_backend})
      if(NOT IS_DIRECTORY "${RNS8_${_backend}_INCLUDE_DIR}")
        message(FATAL_ERROR "Enabled ${_backend} has no resolved include tree for build identity")
      endif()
      string(APPEND _dependency_trees "dependency_tree.${_backend}=${RNS8_${_backend}_INCLUDE_DIR}\n")
    endif()
  endforeach()
  if(RNS8_ENABLE_CK)
    foreach(_tree IN ITEMS RNS8_CK_GENERATED_INCLUDE_DIR RNS8_CK_WMMA_PATCH_INCLUDE_DIR)
      if(${_tree})
        string(APPEND _dependency_trees "dependency_tree.${_tree}=${${_tree}}\n")
      endif()
    endforeach()
  endif()
  foreach(_transport IN ITEMS RCCL ROCSHMEM)
    if(RNS8_ENABLE_${_transport})
      file(SHA256 "${RNS8_${_transport}_LIBRARY}" _transport_hash)
      string(APPEND _dependency_trees "${_transport}_library_sha256=${_transport_hash}\n")
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${RNS8_${_transport}_LIBRARY}")
    endif()
  endforeach()
  if(RNS8_ENABLE_DISTRIBUTED_MPI)
    string(APPEND _dependency_trees "mpi_cxx_version=${MPI_CXX_VERSION}\n")
    set(_mpi_index 0)
    foreach(_include IN LISTS MPI_CXX_INCLUDE_DIRS)
      math(EXPR _mpi_index "${_mpi_index}+1")
      string(APPEND _dependency_trees "dependency_tree.MPI_${_mpi_index}=${_include}\n")
    endforeach()
    foreach(_library IN LISTS MPI_CXX_LIBRARIES)
      if(EXISTS "${_library}")
        file(SHA256 "${_library}" _mpi_hash)
        string(APPEND _dependency_trees "mpi_library.${_library}=${_mpi_hash}\n")
      endif()
    endforeach()
  endif()
  file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/generated/$<CONFIG>/configuration.txt"
    CONTENT "cpu_amx=${RNS8_ENABLE_CPU_AMX}\nresidue_scalar_control=${RNS8_EXPERIMENTAL_RESIDUE_SCALAR_CONTROL}\nresidue_dot4=${RNS8_EXPERIMENTAL_RESIDUE_DOT4}\ngenerated_native_wmma=${RNS8_EXPERIMENTAL_GENERATED_NATIVE_WMMA}\ngarner_table=${RNS8_EXPERIMENTAL_GARNER_TABLE}\nconfig=$<CONFIG>\ncompiler=${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}\ncompiler_path=${CMAKE_CXX_COMPILER}\nflags=${CMAKE_CXX_FLAGS} $<$<CONFIG:Release>:${CMAKE_CXX_FLAGS_RELEASE}>$<$<CONFIG:Debug>:${CMAKE_CXX_FLAGS_DEBUG}>$<$<CONFIG:RelWithDebInfo>:${CMAKE_CXX_FLAGS_RELWITHDEBINFO}>$<$<CONFIG:MinSizeRel>:${CMAKE_CXX_FLAGS_MINSIZEREL}>\nhip=${RNS8_ENABLE_HIP}\nhip_compiler=${RNS8_HIP_HIPCC}\nhip_version=${RNS8_HIPCC_VERSION_TEXT}\nhip_stl_overlay_sha256=${_overlay_hash}\ntargets=${RNS8_AMDGPU_TARGETS}\nhipblaslt=${RNS8_ENABLE_HIPBLASLT}\nhipblaslt_algorithm_index=${RNS8_HIPBLASLT_ALGO_INDEX_AVAILABLE}\nck=${RNS8_ENABLE_CK}\nrocwmma=${RNS8_ENABLE_ROCWMMA}\nbuiltins=${RNS8_ENABLE_AMDGPU_BUILTINS}\ndistributed_mpi=${RNS8_ENABLE_DISTRIBUTED_MPI}\nrccl=${RNS8_ENABLE_RCCL}\nrocshmem=${RNS8_ENABLE_ROCSHMEM}\nopenmp=${RNS8_CPU_PARALLEL_OPENMP}\nvcpkg_installed=${VCPKG_INSTALLED_DIR}\n${_dependency_trees}")
endfunction()
# Capture resolved dependency/backend settings, after all find_package calls.
cmake_language(DEFER CALL rns8_generate_manifest_configuration)
add_custom_target(rns8_build_manifest
  COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/build_manifest.py"
    --source "${CMAKE_CURRENT_SOURCE_DIR}"
    --config "${CMAKE_CURRENT_BINARY_DIR}/generated/$<CONFIG>/configuration.txt"
    --header "${RNS8_MANIFEST_HEADER}"
  BYPRODUCTS "${RNS8_MANIFEST_HEADER}"
  VERBATIM)
function(rns8_bind_manifest target)
  add_dependencies(${target} rns8_build_manifest)
  if(MSVC)
    target_compile_options(${target} PRIVATE "/FI${RNS8_MANIFEST_HEADER}")
  else()
    target_compile_options(${target} PRIVATE -include "${RNS8_MANIFEST_HEADER}")
  endif()
endfunction()
